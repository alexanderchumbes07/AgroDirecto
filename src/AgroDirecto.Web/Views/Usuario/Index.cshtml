@model IEnumerable<AgroDirecto.Web.Models.UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuarios";
    int pagina = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    string? buscar = ViewBag.Buscar as string;
    int? rolId = ViewBag.RolId as int?;
    var roles = ViewBag.Roles as List<AgroDirecto.Web.Models.RolViewModel>
                ?? new List<AgroDirecto.Web.Models.RolViewModel>();
}

<partial name="_MensajeExito" />

<nav aria-label="Ruta" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="PanelAdmin" asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
    </ol>
</nav>

<div class="mb-4">
    <h1 class="mb-1">Usuarios</h1>
    <p class="text-secondary mb-0">
        Activa o desactiva cuentas y aprueba a los agricultores.
        <span class="badge rounded-pill text-bg-light border ms-1">@ViewBag.Total en total</span>
    </p>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-5">
        <label for="buscar" class="form-label">Buscar</label>
        <input type="search" id="buscar" name="buscar" value="@buscar"
               class="form-control" placeholder="Nombre, apellido o correo..." />
    </div>
    <div class="col-sm-3">
        <label for="rolId" class="form-label">Perfil</label>
        <select id="rolId" name="rolId" class="form-select">
            <option value="">Todos</option>
            @foreach (var r in roles)
            {
                <option value="@r.RolId" selected="@(rolId == r.RolId)">@r.Nombre</option>
            }
        </select>
    </div>
    <div class="col-sm-auto">
        <button class="btn btn-agro-outline" type="submit">Filtrar</button>
        @if (!string.IsNullOrWhiteSpace(buscar) || rolId.HasValue)
        {
            <a class="btn btn-link text-secondary" asp-action="Index">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="sin-datos">
        <div class="icono" aria-hidden="true">👥</div>
        <p class="mb-0">No hay usuarios que coincidan con el filtro.</p>
    </div>
}
else
{
    <div class="tabla-scroll">
        <table class="table tabla-agro align-middle">
            <thead>
                <tr>
                    <th scope="col">Usuario</th>
                    <th scope="col">Perfil</th>
                    <th scope="col">Registro</th>
                    <th scope="col" class="text-center">Cuenta</th>
                    <th scope="col" class="text-center">Aprobación</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-medium">@u.NombreCompleto</div>
                            <div class="small text-secondary">@u.Email</div>
                            @if (!string.IsNullOrWhiteSpace(u.NombreComercial))
                            {
                                <div class="small text-secondary">@u.NombreComercial</div>
                            }
                        </td>
                        <td><span class="badge rounded-pill text-bg-light border">@u.Rol</span></td>
                        <td class="text-secondary small">@u.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            @if (u.Estado)
                            {
                                <span class="badge rounded-pill text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-secondary">Desactivada</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!u.EsAgricultor)
                            {
                                <span class="text-secondary">—</span>
                            }
                            else if (u.Aprobado == true)
                            {
                                <span class="badge rounded-pill text-bg-success">Aprobado</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-warning">Pendiente</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (u.EsAgricultor)
                            {
                                <form asp-action="CambiarAprobacion" method="post" class="d-inline">
                                    <input type="hidden" name="agricultorId" value="@u.AgricultorId" />
                                    <input type="hidden" name="aprobado" value="@((u.Aprobado != true).ToString().ToLower())" />
                                    <input type="hidden" name="buscar" value="@buscar" />
                                    <input type="hidden" name="rolId" value="@rolId" />
                                    <input type="hidden" name="pagina" value="@pagina" />
                                    <button type="submit" class="btn btn-sm @(u.Aprobado == true ? "btn-outline-secondary" : "btn-agro")">
                                        @(u.Aprobado == true ? "Quitar aprobación" : "Aprobar")
                                    </button>
                                </form>
                            }

                            <form asp-action="CambiarEstado" method="post" class="d-inline"
                                  onsubmit="return confirm('@(u.Estado ? "¿Desactivar" : "¿Activar") la cuenta de @u.NombreCompleto?');">
                                <input type="hidden" name="usuarioId" value="@u.UsuarioId" />
                                <input type="hidden" name="estado" value="@((!u.Estado).ToString().ToLower())" />
                                <input type="hidden" name="buscar" value="@buscar" />
                                <input type="hidden" name="rolId" value="@rolId" />
                                <input type="hidden" name="pagina" value="@pagina" />
                                <button type="submit" class="btn btn-sm @(u.Estado ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.Estado ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav aria-label="Paginación" class="mt-3">
            <ul class="pagination mb-0">
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-buscar="@buscar" asp-route-rolId="@rolId" asp-route-pagina="@i"
                           aria-current="@(i == pagina ? "page" : null)">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
