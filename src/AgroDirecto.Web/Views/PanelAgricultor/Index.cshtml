@{
    ViewData["Title"] = "Mi panel";
}

<partial name="_MensajeExito" />

<div class="portada mb-4">
    <h1 class="h3 fw-bold mb-2">Hola, @User.Identity?.Name</h1>
    <p class="mb-0">Este es tu panel de agricultor. Desde aquí gestionas tu catálogo y tus pedidos.</p>
</div>

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <a class="card h-100 tarjeta-hover text-decoration-none"
           asp-controller="Producto" asp-action="Index">
            <div class="card-body">
                <div class="fs-3 mb-2" aria-hidden="true">🥬</div>
                <h2 class="card-title h5">Mis productos</h2>
                <p class="card-text text-secondary mb-0">
                    Publica tu cosecha con su precio, stock, categoría y unidad de medida.
                </p>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <a class="card h-100 tarjeta-hover text-decoration-none"
           asp-controller="PedidoAgricultor" asp-action="Index">
            <div class="card-body">
                <div class="fs-3 mb-2" aria-hidden="true">📦</div>
                <h2 class="card-title h5">Pedidos recibidos</h2>
                <p class="card-text text-secondary mb-0">
                    Los pedidos de tus clientes, con lo que corresponde a tus productos.
                </p>
            </div>
        </a>
    </div>

</div>

@* El agricultor no tiene acceso al catálogo: ahí están los precios de los
   demás agricultores. Solo ve y gestiona lo suyo. *@
