@model IEnumerable<AgroDirecto.Web.Models.ProductoViewModel>
@{
    ViewData["Title"] = "Mis productos";
    int pagina = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    string? buscar = ViewBag.Buscar as string;
}

<partial name="_MensajeExito" />

<nav aria-label="Ruta" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="PanelAgricultor" asp-action="Index">Mi panel</a></li>
        <li class="breadcrumb-item active" aria-current="page">Mis productos</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="mb-1">Mis productos</h1>
        <p class="text-secondary mb-0">
            Lo que tienes publicado en el catálogo.
            <span class="badge rounded-pill text-bg-light border ms-1">@ViewBag.Total en total</span>
        </p>
    </div>
    <a class="btn btn-agro" asp-action="Registrar">+ Publicar producto</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
    <div class="col-sm-auto flex-grow-1" style="max-width: 26rem;">
        <label for="buscar" class="visually-hidden">Buscar producto</label>
        <input type="search" id="buscar" name="buscar" value="@buscar"
               class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-sm-auto">
        <button class="btn btn-agro-outline" type="submit">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a class="btn btn-link text-secondary" asp-action="Index">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="sin-datos">
        <div class="icono" aria-hidden="true">🥬</div>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <p class="mb-3">No encontramos productos que coincidan con <strong>“@buscar”</strong>.</p>
            <a class="btn btn-agro-outline" asp-action="Index">Ver todos</a>
        }
        else
        {
            <p class="mb-3">Todavía no has publicado ningún producto.</p>
            <a class="btn btn-agro" asp-action="Registrar">Publicar el primero</a>
        }
    </div>
}
else
{
    <div class="tabla-scroll">
        <table class="table tabla-agro align-middle">
            <thead>
                <tr>
                    <th scope="col">Producto</th>
                    <th scope="col">Categoría</th>
                    <th scope="col" class="text-end">Precio</th>
                    <th scope="col" class="text-end">Stock</th>
                    <th scope="col" class="text-end">Mín. Compra</th>
                    <th scope="col" class="text-center">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-medium">@p.Nombre</td>
                        <td class="text-secondary">@p.Categoria</td>
                        <td class="text-end text-nowrap">S/ @p.Precio.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            @p.Stock.ToString("N2") <span class="text-secondary">@p.Unidad</span>
                            @if (p.Stock <= 0)
                            {
                                <span class="badge rounded-pill text-bg-warning ms-1">Agotado</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">S/ @p.MontoMinimo.ToString("N2")</td>
                        <td class="text-center">
                            @if (p.Estado)
                            {
                                <span class="badge rounded-pill text-bg-success">Publicado</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-secondary">Oculto</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Editar" asp-route-id="@p.ProductoId"
                               class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@p.ProductoId" method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('¿Eliminar @p.Nombre?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav aria-label="Paginación" class="mt-3">
            <ul class="pagination mb-0">
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-buscar="@buscar" asp-route-pagina="@i"
                           aria-current="@(i == pagina ? "page" : null)">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
