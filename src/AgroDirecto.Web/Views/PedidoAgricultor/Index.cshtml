@model IEnumerable<AgroDirecto.Web.Models.PedidoViewModel>
@{
    ViewData["Title"] = "Pedidos recibidos";
}

<partial name="_MensajeExito" />

<nav aria-label="Ruta" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="PanelAgricultor" asp-action="Index">Mi panel</a></li>
        <li class="breadcrumb-item active" aria-current="page">Pedidos recibidos</li>
    </ol>
</nav>

<div class="mb-4">
    <h1 class="mb-1">Pedidos recibidos</h1>
    <p class="text-secondary mb-0">
        Solo aparecen tus productos. Confirma el pedido, coordina la entrega con el cliente
        y márcalo como entregado cuando se lo lleves.
    </p>
</div>

@* Aquí aparece el aviso cuando entra un pedido mientras miras la página *@
<div id="pedido-nuevo" class="alert alert-success d-none" role="status">
    <strong>¡Pedido nuevo!</strong> <span id="pedido-nuevo-texto"></span>
    <a href="" onclick="location.reload(); return false;" class="alert-link ms-1">Actualizar</a>
</div>

@if (!Model.Any())
{
    <div class="sin-datos">
        <div class="icono" aria-hidden="true">📦</div>
        <p class="mb-0">Todavía no has recibido pedidos.</p>
    </div>
}
else
{
    @foreach (var p in Model)
    {
        <section class="card mb-3">
            <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h2 class="h6 mb-0">Pedido #@p.PedidoId</h2>
                    <div class="small text-secondary">@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <partial name="_EstadoPedido" model="@p.Estado" />
            </div>

            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <div class="text-secondary small">Cliente</div>
                        <div class="fw-medium">@p.Cliente</div>
                        @if (!string.IsNullOrEmpty(p.TelefonoCliente))
                        {
                            <a class="small" href="tel:@p.TelefonoCliente">@p.TelefonoCliente</a>
                        }
                    </div>
                    <div class="col-sm-6">
                        <div class="text-secondary small">Entregar en</div>
                        <div>@p.DireccionEntrega</div>
                    </div>
                </div>

                <div class="tabla-scroll">
                    <table class="table tabla-agro align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Producto</th>
                                <th scope="col" class="text-end">Cantidad</th>
                                <th scope="col" class="text-end">Precio</th>
                                <th scope="col" class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in p.Detalle)
                            {
                                <tr>
                                    <td>@d.Nombre</td>
                                    <td class="text-end text-nowrap">@d.Cantidad.ToString("0.##") @d.Unidad</td>
                                    <td class="text-end text-nowrap">S/ @d.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end fw-medium text-nowrap">S/ @d.Subtotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end text-secondary">Total de tus productos</td>
                                <td class="text-end fw-bold text-nowrap">S/ @p.Total.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            @if (p.PuedeConfirmar || p.PuedeEntregar || p.PuedeCancelar)
            {
                <div class="card-footer bg-white d-flex flex-wrap gap-2">
                    @if (p.PuedeConfirmar)
                    {
                        <form asp-action="Confirmar" asp-route-id="@p.PedidoId" method="post">
                            <button type="submit" class="btn btn-sm btn-agro">Confirmar pedido</button>
                        </form>
                    }

                    @if (p.PuedeEntregar)
                    {
                        <form asp-action="Entregar" asp-route-id="@p.PedidoId" method="post">
                            <button type="submit" class="btn btn-sm btn-agro">Marcar como entregado</button>
                        </form>
                    }

                    @if (p.PuedeCancelar)
                    {
                        <form asp-action="Cancelar" asp-route-id="@p.PedidoId" method="post"
                              onsubmit="return confirm('¿Cancelar este pedido? El stock volverá a estar disponible y no se puede deshacer.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="card-footer bg-white text-secondary small">
                    @(p.Estado == "Entregado"
                        ? "Pedido entregado. No hay nada más que hacer."
                        : "Pedido cancelado. El stock se devolvió al inventario.")
                </div>
            }
        </section>
    }
}

@section Scripts {
    <script src="~/js/signalr.min.js"></script>
    <script src="~/js/avisos.js"></script>
    <script>
        // Un cliente acaba de comprar algo tuyo.
        AgroAvisos.conexion.on("PedidoNuevo", function (datos) {
            const caja = document.getElementById("pedido-nuevo");
            // textContent, nunca innerHTML: el nombre del cliente lo escribió
            // una persona y no debe interpretarse como HTML.
            document.getElementById("pedido-nuevo-texto").textContent =
                datos.cliente + " pidió " + datos.items + " producto(s) por S/ " + datos.total.toFixed(2) + ".";
            caja.classList.remove("d-none");

            AgroAvisos.mostrar("Pedido nuevo de " + datos.cliente + " por S/ " + datos.total.toFixed(2));
        });

        AgroAvisos.iniciar();
    </script>
}
