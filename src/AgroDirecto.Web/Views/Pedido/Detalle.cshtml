@model AgroDirecto.Web.Models.CompraViewModel
@{
    ViewData["Title"] = $"Pedido #{Model.CompraId}";
}

<partial name="_MensajeExito" />

<nav aria-label="Ruta" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="PanelCliente" asp-action="Index">Mi panel</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Mis pedidos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Pedido #@Model.CompraId</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="mb-1">Pedido #@Model.CompraId</h1>
        <p class="text-secondary mb-0">
            @Model.FechaCompra.ToString("dd/MM/yyyy HH:mm") · Entrega en @Model.DireccionEntrega, @Model.Distrito
            @if (!string.IsNullOrWhiteSpace(Model.Referencia))
            {
                <text> (@Model.Referencia)</text>
            }
        </p>
    </div>
    <div class="text-end">
        <div class="text-secondary small">Total del pedido</div>
        <div class="h3 mb-0" style="color: var(--verde-700);">S/ @Model.Total.ToString("N2")</div>
    </div>
</div>

@if (Model.Proveedores > 1)
{
    <div class="alert alert-light border">
        Tu pedido incluye productos de <strong>@Model.Proveedores agricultores</strong>.
        Cada uno prepara y entrega su parte por separado, así que te contactarán por separado
        y cada parte avanza a su propio ritmo.
    </div>
}

@foreach (var pedido in Model.Pedidos)
{
    <section class="card mb-3" data-pedido="@pedido.PedidoId">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h6 mb-0">@pedido.Agricultor</h2>
                <div class="small text-secondary">
                    @if (!string.IsNullOrEmpty(pedido.DistritoAgricultor))
                    {
                        <span>@pedido.DistritoAgricultor</span>
                    }
                    @if (!string.IsNullOrEmpty(pedido.TelefonoAgricultor))
                    {
                        <span> · Tel. @pedido.TelefonoAgricultor</span>
                    }
                </div>
            </div>
            <span data-celda="estado"><partial name="_EstadoPedido" model="@pedido.Estado" /></span>
        </div>

        <div class="tabla-scroll">
            <table class="table tabla-agro align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Producto</th>
                        <th scope="col" class="text-end">Cantidad</th>
                        <th scope="col" class="text-end">Precio</th>
                        <th scope="col" class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in pedido.Detalle)
                    {
                        <tr>
                            <td>@d.Nombre</td>
                            <td class="text-end text-nowrap">@d.Cantidad.ToString("0.##") @d.Unidad</td>
                            <td class="text-end text-nowrap">S/ @d.PrecioUnitario.ToString("N2")</td>
                            <td class="text-end fw-medium text-nowrap">S/ @d.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end text-secondary">Subtotal de este agricultor</td>
                        <td class="text-end fw-bold text-nowrap">S/ @pedido.Total.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
    <a class="btn btn-outline-secondary" asp-action="Index">← Volver a mis pedidos</a>
    <div class="text-end">
        <span class="text-secondary me-2">Total del pedido</span>
        <span class="h4 mb-0" style="color: var(--verde-700);">S/ @Model.Total.ToString("N2")</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr.min.js"></script>
    <script src="~/js/avisos.js"></script>
    <script>
        // Aquí el aviso cambia el estado del proveedor concreto, no el de
        // toda la compra: cada agricultor avanza por su cuenta.
        AgroAvisos.conexion.on("EstadoCambiado", function (datos) {
            const seccion = document.querySelector('[data-pedido="' + datos.pedidoId + '"]');
            if (!seccion) return;

            const clases = {
                "Pendiente":  "text-bg-warning",
                "Confirmado": "text-bg-info",
                "Entregado":  "text-bg-success",
                "Cancelado":  "text-bg-secondary"
            };
            const celda = seccion.querySelector('[data-celda="estado"]');
            if (celda) {
                celda.innerHTML = '<span class="badge rounded-pill ' + (clases[datos.estado] || "text-bg-light border") + '"></span>';
                celda.querySelector("span").textContent = datos.estado;
            }

            const proveedor = seccion.querySelector("h2");
            AgroAvisos.mostrar((proveedor ? proveedor.textContent.trim() : "Un agricultor")
                + ": tu pedido ahora está " + datos.estado.toLowerCase() + ".");
        });

        AgroAvisos.iniciar();
    </script>
}
