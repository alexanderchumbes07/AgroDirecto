@model AgroDirecto.Web.Models.UnidadMedidaViewModel
@{
    ViewData["Title"] = "Editar unidad de medida";
}

<nav aria-label="Ruta" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="PanelAdmin" asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Unidades de medida</a></li>
        <li class="breadcrumb-item active" aria-current="page">Editar</li>
    </ol>
</nav>

<h1 class="mb-4">Editar unidad de medida</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Editar" method="post" class="panel-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="UnidadMedidaId" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" autofocus />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Abreviatura" class="form-label"></label>
                <input asp-for="Abreviatura" class="form-control" style="max-width: 10rem;" />
                <span asp-validation-for="Abreviatura" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-agro">Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>
