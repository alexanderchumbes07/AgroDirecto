@model AgroDirecto.Web.Models.UnidadMedidaViewModel
@{
    ViewData["Title"] = Model.Nombre;
}

<nav aria-label="Ruta" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="PanelAdmin" asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Unidades de medida</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Nombre</li>
    </ol>
</nav>

<h1 class="mb-4">@Model.Nombre</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-secondary fw-normal">Código</dt>
                    <dd class="col-sm-8">@Model.UnidadMedidaId</dd>

                    <dt class="col-sm-4 text-secondary fw-normal">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4 text-secondary fw-normal">Abreviatura</dt>
                    <dd class="col-sm-8 mb-0">
                        <span class="badge rounded-pill text-bg-light border">@Model.Abreviatura</span>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <a asp-action="Editar" asp-route-id="@Model.UnidadMedidaId" class="btn btn-agro">Editar</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
        </div>
    </div>
</div>
