<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgroDirecto.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Acceso a SQL Server con ADO.NET. Es el único paquete que
         necesita el proyecto: no se usa Entity Framework. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
